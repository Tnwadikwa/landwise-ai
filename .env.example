# Public URL used for SEO links and sitemap generation.
SITE_URL=https://landwiseai.com
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENT_BUCKET=landwise-documents
# Used automatically when Supabase storage variables are empty during local development.
LOCAL_DOCUMENT_PATH=/tmp/landwise-ai-documents
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Projections are blocked when the submitted location cannot be verified.
LOCATION_VALIDATION_ENABLED=true
# Optional: without this key, the API returns fallback marketing copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_COVERAGE_RATIO=0.50
COST_PER_SQM_NGN=350000
UNIT_BUILT_AREA_SQM=250
UNIT_SALE_PRICE_NGN=180000000
